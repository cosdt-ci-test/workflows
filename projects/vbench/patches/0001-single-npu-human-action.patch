diff --git a/vbench/device.py b/vbench/device.py
new file mode 100644
index 0000000..fbddaab
--- /dev/null
+++ b/vbench/device.py
@@ -0,0 +1,25 @@
+"""Select a device for single-device VBench evaluation."""
+
+import os
+import torch
+
+
+def get_device(requested=None):
+    """Register the NPU backend when needed; explicit NPU never falls back."""
+    if requested is not None and not str(requested).startswith('npu'):
+        return torch.device(requested)
+    try:
+        import torch_npu  # noqa: F401
+    except ImportError as exc:
+        if requested is not None:
+            raise RuntimeError('NPU evaluation requires torch_npu') from exc
+    available = hasattr(torch, 'npu') and torch.npu.is_available()
+    if not available:
+        if requested is not None:
+            raise RuntimeError('The requested Ascend NPU is not available')
+        return torch.device('cuda' if torch.cuda.is_available() else 'cpu')
+    device = torch.device(requested or f'npu:{os.environ.get("LOCAL_RANK", "0")}')
+    if device.index is None:
+        device = torch.device(f'npu:{os.environ.get("LOCAL_RANK", "0")}')
+    torch.npu.set_device(device)
+    return device
